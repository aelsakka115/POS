{
  "name": "cafe-engine",
  "private": true,
  "version": "0.0.0",
  "description": "Cafe Engine — Multi-tenant SaaS Cafe Operating System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.64.0"
  }
}
