{
  "name": "cafe-engine",
  "private": true,
  "version": "0.0.0",
  "description": "Cafe Engine — Multi-tenant SaaS Cafe Operating System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
